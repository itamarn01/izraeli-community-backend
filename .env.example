# ── Server ──────────────────────────────────────────────
PORT=5000
# Set to "production" on the live server. Enables HSTS, HTTPS redirect and trust proxy.
NODE_ENV=development

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/izraeli-community

# ── Auth ────────────────────────────────────────────────
# Use a long, random secret (e.g. `openssl rand -hex 32`). NEVER commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: required to create additional admins after the first bootstrap.
ADMIN_SETUP_KEY=

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed front-end origins, e.g.
# https://app.izraeli186.org.il,https://izraeli186.org.il
CLIENT_ORIGIN=

# ── Email (Flashy) ──────────────────────────────────────
# The app's only mail provider — OTP, coupons, event confirmations, admin
# messages and broadcasts all go through it.
# API key: Flashy dashboard → Settings → API. Docs: https://flashy.app/docs/rest-api/
FLASHY_API_KEY=
# Must be a sender address verified inside your Flashy account, or sends bounce.
FLASHY_FROM_EMAIL=
FLASHY_FROM_NAME=קהילת חטיבת יזרעאלי
# Left unset, no mail is sent — codes and messages are logged to the server
# console instead, which is what local development uses.

# Optional: public origin of THIS API, used for the .ics calendar links in
# event emails. Falls back to the request host, so it is only needed when the
# API sits behind a proxy that rewrites the host header.
API_URL=

# ── Cloudinary (image uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
